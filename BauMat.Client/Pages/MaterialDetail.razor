@page "/material/{id:int}"

<PageTitle>@(Gefunden?.Name ?? $"Material {Id}")</PageTitle>

<div class="md-page">

    @* Prototyp: feste Rückkehr zur Boden-Liste. Sobald die Kategorie im
       Datenmodell steckt wird das Ziel dynamisch abgeleitet. *@
    <a class="md-back" href="katalog/boden">← Zurück zur Liste</a>

    @if (Gefunden is not null)
    {
        <header class="md-header">
            <div class="md-header-text">
                <p class="md-eyebrow">@Gefunden.Konstruktionstyp</p>
                <h1 class="md-title">@Gefunden.Name</h1>
            </div>
            <button type="button" class="md-print" @onclick="Drucken">
                Drucken
            </button>
        </header>

        <section class="md-description">
            <p>@Gefunden.Beschreibung</p>
        </section>

        <section class="md-info">
            <div class="md-info-block">
                <h2 class="md-section-title">Anwendung</h2>
                <p>@Gefunden.Anwendung</p>
            </div>
            <div class="md-info-block">
                <h2 class="md-section-title">Eigenschaften</h2>
                <p>@Gefunden.Eigenschaften</p>
            </div>
            <div class="md-info-block">
                <h2 class="md-section-title">Hinweise</h2>
                <p>@Gefunden.Hinweise</p>
            </div>
        </section>

        <section>
            <h2 class="md-section-title">Parameter</h2>
            <div class="md-table-wrap">
                <table class="md-table">
                    <thead>
                        <tr>
                            <th class="md-col-param">Parameter</th>
                            <th class="md-col-wert">Wert</th>
                            <th class="md-col-einheit">Einheit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in GetParameterTable(Gefunden))
                        {
                            <tr>
                                <td class="md-cell-param">@p.Name</td>
                                <td class="md-cell-wert">@p.Wert</td>
                                <td class="md-cell-einheit">@p.Einheit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="md-info">
            <div class="md-info-block">
                <h2 class="md-section-title">Einordnung der Werte</h2>
                <p>@Gefunden.Einordnung</p>
            </div>
        </section>
    }

</div>