@page "/material/{id:int}"
@inject MaterialService MaterialService

<PageTitle>@(Material?.Name ?? $"Material {Id}")</PageTitle>

<div class="md-page">

    @* Prototype: fixed link back to the floor list. Once the category lives
       in the data model, the target is derived dynamically. *@
    <a class="md-back" href="katalog">← Zurück zur Liste</a>

    @if (Material is not null)
    {
        <header class="md-header">
            <div class="md-header-text">
                <p class="md-eyebrow">@Material.ConstructionType</p>
                <h1 class="md-title">@Material.Name</h1>
            </div>
            <button type="button" class="md-print" @onclick="Print">
                Drucken
            </button>
        </header>

        <section class="md-description">
            <p>@Material.Description</p>
        </section>

        <section class="md-info">
            <div class="md-info-block">
                <h2 class="md-section-title">Anwendung</h2>
                <p>@Material.Application</p>
            </div>
            <div class="md-info-block">
                <h2 class="md-section-title">Eigenschaften</h2>
                <p>@Material.Characteristics</p>
            </div>
            <div class="md-info-block">
                <h2 class="md-section-title">Hinweise</h2>
                <p>@Material.Notes</p>
            </div>
        </section>

        <section>
            <h2 class="md-section-title">Parameter</h2>
            <div class="md-table-wrap">
                <table class="md-table">
                    <thead>
                        <tr>
                            <th class="md-col-param">Parameter</th>
                            <th class="md-col-wert">Wert</th>
                            <th class="md-col-einheit">Einheit</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in GetParameterTable(Material))
                        {
                            <tr>
                                <td class="md-cell-param">@p.Name</td>
                                <td class="md-cell-wert">@p.Value</td>
                                <td class="md-cell-einheit">@p.Unit</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="md-info">
            <div class="md-info-block">
                <h2 class="md-section-title">Einordnung der Werte</h2>
                <p>@Material.Interpretation</p>
            </div>
        </section>
    }

</div>

@code {
    [Parameter] public int Id { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    protected override void OnParametersSet()
    {
        Material = MaterialService.GetById(Id);

        if (Material is null)
            Navigation.NotFound();
    }

    private async Task Print()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private Material? Material { get; set; }

    // ── Parameter rows for the table ───────────────────────────────────────

    private record Parameter(string Name, string Value, string Unit);

    // Stateless on purpose: takes the material as an argument instead of
    // reading instance state, which keeps it easy to test in isolation.
    private static IEnumerable<Parameter> GetParameterTable(Material? material)
    {
        if (material is null) yield break;

        yield return new("PET Tag", material.PetTag.ToString("0.0"), "°C");
        yield return new("Albedo", material.Albedo.ToString("0.00"), "-");
        yield return new("Lebensdauer", material.Lifespan.ToString(), "Jahre");
        yield return new("THG", material.Ghg.ToString("0"), "kg CO₂-eq/m²");
    }
}