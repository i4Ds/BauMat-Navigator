    // ── Parameter rows for the table ───────────────────────────────────────

    private record Parameter(string Name, string Value, string Unit);

    // Stateless on purpose: takes the material as an argument instead of
    // reading instance state, which keeps it easy to test in isolation.
    private static IEnumerable<Parameter> GetParameterTable(MaterialData? material)
    {
        if (material is null) yield break;

        yield return new("PET Tag", material.PetTag.ToString("0.0"), "°C");
        yield return new("Albedo", material.Albedo.ToString("0.00"), "-");
        yield return new("Lebensdauer", material.Lifespan.ToString(), "Jahre");
        yield return new("THG", material.Ghg.ToString("0"), "kg CO₂-eq/m²");
    }
