<div class="cvt-toggle" role="group" aria-label="Ansicht wählen">
    <a class="cvt-option @(Active == "table" ? "cvt-active" : "")"
       href="vergleich"
       aria-current="@(Active == "table" ? "page" : null)">
        Tabelle
    </a>
    <a class="cvt-option @(Active == "cards" ? "cvt-active" : "")"
       href="vergleich2"
       aria-current="@(Active == "cards" ? "page" : null)">
        Karten
    </a>
</div>

@code {
    [Parameter, EditorRequired]
    public string Active { get; set; } = "table";
}
