@page "/katalog/{kategorie}"

<PageTitle>Katalog – @Kategorie</PageTitle>

<div class="ml-page">

    <header class="ml-header">
        <h1 class="ml-title">Katalog: @Kategorie</h1>
        <p class="ml-subtitle">@FilterStatus</p>
    </header>

    @* ── Filter ──────────────────────────────────────────── *@
    <div class="ml-filter-row">
        <span class="ml-filter-label">Konstruktionstyp:</span>
        @foreach (var typ in Konstruktionstypen)
        {
            <button type="button"
                    class="ml-chip @(typ == aktiverTyp ? "ml-chip-active" : "")"
                    @onclick="() => SetzeFilter(typ)">
                @typ
            </button>
        }
    </div>

    @* ── Tabelle ─────────────────────────────────────────── *@
    <div class="ml-table-wrap">
        <table class="ml-table">
            <thead>
                <tr>
                    <th class="ml-col-name">Material</th>
                    <th class="ml-col-typ">Konstruktionstyp</th>
                    <th class="ml-col-num">PET Tag</th>
                    <th class="ml-col-num">Albedo</th>
                    <th class="ml-col-num">Lebensdauer</th>
                    <th class="ml-col-num">THG</th>
                </tr>
                <tr class="ml-units">
                    <th></th>
                    <th></th>
                    <th>°C</th>
                    <th>-</th>
                    <th>Jahre</th>
                    <th>kg CO₂-eq/m²</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in GefilterteMaterialien)
                {
                    <tr>
                        <td class="ml-cell-name">@m.Name</td>
                        <td class="ml-cell-typ">@m.Konstruktionstyp</td>
                        <td class="ml-cell-num">@m.PetTag.ToString("0.0")</td>
                        <td class="ml-cell-num">@m.Albedo.ToString("0.00")</td>
                        <td class="ml-cell-num">@m.Lebensdauer</td>
                        <td class="ml-cell-num">@m.Thg.ToString("0")</td>
                    </tr>
                }
                @if (!GefilterteMaterialien.Any())
                {
                    <tr>
                        <td colspan="6" class="ml-empty">
                            Keine Materialien für Filter „@aktiverTyp".
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

@code {
    [Parameter] public string Kategorie { get; set; } = "";

    private const string Alle = "Alle";
    private string aktiverTyp = Alle;

    // ── Mock-Daten ────────────────────────────────────────────────────────
    //
    // Inline-Daten für den Prototyp. Echte Daten aus dem PDF-Katalog
    // werden in Issue #11 (JSON + Deserialisierung) angebunden.

    private record Material(
        int Id,
        string Name,
        string Konstruktionstyp,
        double PetTag,
        double Albedo,
        int Lebensdauer,
        double Thg);

    private readonly List<Material> Materialien = new()
    {
        new(1, "Asphalt dunkel",          "Versiegelt",     38.2, 0.08, 25, 45),
        new(2, "Kiesbelag",               "Unversiegelt",   32.1, 0.30, 30, 12),
        new(3, "Rasen",                   "Begrünt",        28.5, 0.25, 15,  5),
        new(4, "Steinplattenpflästerung", "Versiegelt",     35.0, 0.20, 60, 65),
        new(5, "Betonpflaster, hell",     "Teilversiegelt", 33.5, 0.45, 40, 38),
    };

    // ── Abgeleitete Werte ─────────────────────────────────────────────────

    private IEnumerable<string> Konstruktionstypen =>
        new[] { Alle }
            .Concat(Materialien.Select(m => m.Konstruktionstyp).Distinct().OrderBy(s => s));

    private IEnumerable<Material> GefilterteMaterialien =>
        aktiverTyp == Alle
            ? Materialien
            : Materialien.Where(m => m.Konstruktionstyp == aktiverTyp);

    private string FilterStatus
    {
        get
        {
            var total = Materialien.Count;
            var gezeigt = GefilterteMaterialien.Count();
            return aktiverTyp == Alle
                ? $"{total} Materialien"
                : $"{gezeigt} von {total} Materialien";
        }
    }

    // ── Event-Handler ─────────────────────────────────────────────────────

    private void SetzeFilter(string typ) => aktiverTyp = typ;
}