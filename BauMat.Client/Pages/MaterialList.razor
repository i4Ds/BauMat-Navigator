@page "/katalog"
@page "/katalog/{category}"
@implements IDisposable
@inject CompareState CompareState
@inject MaterialService MaterialService

<PageTitle>@PageHeading</PageTitle>

<div class="ml-page">

    @if (IsReturnContext)
    {
        <div class="ml-return-banner">
            <span class="ml-return-text">
                @(IsReferenceSlot ? "Neues Referenzmaterial auswählen" : "Material zum Vergleich hinzufügen")
            </span>
            <a class="ml-return-link" href="@ReturnHref">← Zurück zum Vergleich</a>
        </div>
    }

    <header class="ml-header">
        <h1 class="ml-title">@PageHeading</h1>
        <p class="ml-subtitle">@FilterStatus@(CompareState.Count > 0 ? $" · {CompareState.Count} im Vergleich" : "")</p>

        @if (CompareState.Count > 0 && !IsReturnContext)
        {
            <a class="ml-compare-nav" href="vergleich">
                Vergleich anzeigen (@CompareState.Count) →
            </a>
        }
    </header>

    <div class="ml-layout">

        @* ── Sidebar ─────────────────────────────────────── *@
        <aside class="ml-sidebar">

            @* ── Filter panel (collapsed by default) ───────── *@
            <section class="ml-panel @(filterOpen ? "ml-panel-open" : "")">
                <button type="button" class="ml-panel-head" @onclick="ToggleFilter">
                    <span class="ml-panel-caret">@(filterOpen ? "▾" : "▸")</span>
                    <span class="ml-panel-title">Filter</span>
                    <span class="ml-panel-meta">@ActiveType</span>
                </button>
                @if (filterOpen)
                {
                    <div class="ml-panel-body">
                        <p class="ml-panel-label">Konstruktionstyp</p>
                        <div class="ml-chip-stack">
                            @foreach (var type in ConstructionTypes)
                            {
                                <button type="button"
                                        class="ml-chip @(type == ActiveType ? "ml-chip-active" : "")"
                                        @onclick="() => ActiveType = type">
                                    @type
                                </button>
                            }
                        </div>
                    </div>
                }
            </section>

            @* ── Weighting panel (open by default) ────────── *@
            <section class="ml-panel @(weightingOpen ? "ml-panel-open" : "")">
                <button type="button" class="ml-panel-head" @onclick="ToggleWeighting">
                    <span class="ml-panel-caret">@(weightingOpen ? "▾" : "▸")</span>
                    <span class="ml-panel-title">Gewichtung</span>
                </button>
                @if (weightingOpen)
                {
                    <div class="ml-panel-body">
                        <p class="ml-panel-hint">
                            Welche Parameter sind dir wichtig?
                            (Demo — die Tabelle reagiert noch nicht.)
                        </p>
                        @foreach (var p in WeightParameters)
                        {
                            var current = weights.TryGetValue(p, out var w) ? w : 0;
                            var inputId = $"w-{p.Replace(" ", "-")}";
                            <div class="ml-weight-row">
                                <label class="ml-weight-label" for="@inputId">@p</label>
                                <input id="@inputId"
                                       type="range"
                                       min="0"
                                       max="5"
                                       step="1"
                                       class="ml-slider"
                                       value="@current"
                                       @oninput="(e) => SetWeight(p, e.Value)" />
                                <span class="ml-weight-value">@current</span>
                            </div>
                        }
                        <button type="button"
                                class="ml-reset"
                                @onclick="ResetWeights">
                            Zurücksetzen
                        </button>
                    </div>
                }
            </section>

        </aside>

        @* ── Table ───────────────────────────────────────── *@
        <div class="ml-table-wrap">
            <table class="ml-table">
                <thead>
                    <tr>
                        <th class="ml-col-name">Material</th>
                        <th class="ml-col-typ">Konstruktionstyp</th>
                        <th class="ml-col-num">PET Tag</th>
                        <th class="ml-col-num">Albedo</th>
                        <th class="ml-col-num">Lebensdauer</th>
                        <th class="ml-col-num">THG</th>
                        <th class="ml-col-action">Aktion</th>
                    </tr>
                    <tr class="ml-units">
                        <th></th>
                        <th></th>
                        <th class="ml-col-num">°C</th>
                        <th class="ml-col-num">-</th>
                        <th class="ml-col-num">Jahre</th>
                        <th class="ml-col-num">kg CO₂-eq/m²</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in FilteredMaterials)
                    {
                        <tr class="ml-row-link @(CompareState.Contains(m.Id) ? "ml-row-compared" : "")"
                            tabindex="0"
                            role="link"
                            aria-label="@($"{m.Name} öffnen")"
                            @onclick="() => OpenDetail(m.Id)"
                            @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") OpenDetail(m.Id); })">
                            <td class="ml-cell-name">@m.Name</td>
                            <td class="ml-cell-typ">@m.ConstructionType</td>
                            <td class="ml-cell-num">@m.PetTag.ToString("0.0")</td>
                            <td class="ml-cell-num">@m.Albedo.ToString("0.00")</td>
                            <td class="ml-cell-num">@m.Lifespan</td>
                            <td class="ml-cell-num">@m.Ghg.ToString("0")</td>
                            <td class="ml-cell-action">
                                @if (IsReferenceSlot)
                                {
                                    var isCurrentReference = CompareState.ReferenceId == m.Id;
                                    var isAtLimit = !CompareState.Contains(m.Id) && CompareState.IsFull;
                                    <button class="ml-compare-btn @(isCurrentReference ? "compared" : "")"
                                            type="button"
                                            disabled="@(isCurrentReference || isAtLimit)"
                                            title="@(isAtLimit ? $"Maximal {CompareState.MaxCount} Materialien im Vergleich" : null)"
                                            @onclick="() => SelectReference(m.Id)"
                                            @onclick:stopPropagation="true"
                                            @onkeydown:stopPropagation="true">
                                        @(isCurrentReference ? "✓ Aktuelle Referenz" : "Als Referenz wählen")
                                    </button>
                                }
                                else
                                {
                                    var isAtLimit = !CompareState.Contains(m.Id) && CompareState.IsFull;
                                    <button class="ml-compare-btn @(CompareState.Contains(m.Id) ? "compared" : "")"
                                            type="button"
                                            disabled="@isAtLimit"
                                            title="@(isAtLimit ? $"Maximal {CompareState.MaxCount} Materialien im Vergleich" : null)"
                                            @onclick="() => CompareState.Toggle(m.Id)"
                                            @onclick:stopPropagation="true"
                                            @onkeydown:stopPropagation="true">
                                        @(CompareState.Contains(m.Id) ? "✓ Im Vergleich" : "+ Vergleichen")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!FilteredMaterials.Any())
                    {
                        <tr>
                            <td colspan="7" class="ml-empty">
                                Keine Materialien für Filter „@ActiveType".
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@code {
    // Catalog list view of a material category (Issue #3).

    // Category from the route (/katalog or /katalog/{category}).
    [Parameter] public string Category { get; set; } = "";

    // ── Return context ────────────────────────────────────────────────────
    //
    // The comparison views link here with ?returnTo=table|cards (optionally
    // &slot=reference for a reference-material swap) so the catalog can send
    // the user straight back to where they came from.

    [SupplyParameterFromQuery(Name = "returnTo")]
    [Parameter]
    public string? ReturnTo { get; set; }

    [SupplyParameterFromQuery(Name = "slot")]
    [Parameter]
    public string? Slot { get; set; }

    private ComparisonView? ReturnView =>
        Enum.TryParse<ComparisonView>(ReturnTo, ignoreCase: true, out var view) ? view : null;

    private CompareSlot SelectedSlot =>
        Enum.TryParse<CompareSlot>(Slot, ignoreCase: true, out var slot) ? slot : CompareSlot.Candidate;

    private bool IsReturnContext => ReturnView is not null;

    private bool IsReferenceSlot => SelectedSlot == CompareSlot.Reference;

    // No returnTo means there's no comparison page to go back to; fall back
    // to the card view, since the reference concept only exists there.
    private string ReturnHref =>
        (ReturnView ?? (IsReferenceSlot ? ComparisonView.Cards : ComparisonView.Table)).Href();

    private void SelectReference(int id)
    {
        CompareState.SetReference(id);
        Navigation.NavigateTo(ReturnHref);
    }

    private string PageHeading => string.IsNullOrEmpty(Category) ? "Katalog" : $"Katalog: {Category}";

    // ── Filter ─────────────────────────────────────────────────────────────

    private const string All = "Alle";

    private string ActiveType { get; set; } = All;

    private IEnumerable<string> ConstructionTypes =>
        new[] { All }
            .Concat(MaterialService.All.Select(m => m.ConstructionType).Distinct().OrderBy(s => s));

    private IEnumerable<Material> FilteredMaterials =>
        ActiveType == All
            ? MaterialService.All
            : MaterialService.All.Where(m => m.ConstructionType == ActiveType);

    private string FilterStatus
    {
        get
        {
            var total = MaterialService.All.Count;
            var shown = FilteredMaterials.Count();
            return ActiveType == All
                ? $"{total} Materialien"
                : $"{shown} von {total} Materialien";
        }
    }

    // ── Panel visibility ───────────────────────────────────────────────────

    private bool filterOpen = false;
    private bool weightingOpen = true;

    private void ToggleFilter() => filterOpen = !filterOpen;
    private void ToggleWeighting() => weightingOpen = !weightingOpen;

    // ── Weighting ──────────────────────────────────────────────────────────
    //
    // TODO: the weights are not applied to the table sorting yet. The actual
    // weighted sorting (MCDM – Multi-Criteria Decision Making) follows in a
    // later step.

    private static readonly string[] WeightParameters =
        { "PET Tag", "Albedo", "Lebensdauer", "THG" };

    private readonly Dictionary<string, int> weights = new();

    private void SetWeight(string parameter, object? value)
    {
        if (int.TryParse(value?.ToString(), out var g))
        {
            weights[parameter] = Math.Clamp(g, 0, 5);
        }
    }

    private void ResetWeights()
    {
        foreach (var p in WeightParameters)
            weights[p] = 0;
    }

    // ── Navigation to the detail page ──────────────────────────────────────

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void OpenDetail(int id) => Navigation.NavigateTo($"material/{id}");

    // ── Compare selection ────────────────────────────────────────────────
    //
    // Shared across components via the scoped CompareState service (Issue #9).

    protected override void OnInitialized()
    {
        foreach (var p in WeightParameters)
            weights[p] = 0;

        CompareState.OnChanged += HandleCompareStateChanged;
    }

    private void HandleCompareStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CompareState.OnChanged -= HandleCompareStateChanged;
    }
}