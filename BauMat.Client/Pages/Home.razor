@page "/"

<PageTitle>Klimamaterial – Katalog</PageTitle>

<div class="home-page">
    <section class="hero-section" aria-labelledby="home-title">
        <div class="hero-image-placeholder">
            <img src="images/basel-g429cbea45_1280.jpg" alt="Basel Architektur Herobereich" class="Testbild">
        </div>
    </section>

    <nav class="home-section-nav" aria-label="Startseiten-Navigation">
        <NavLink href="/katalog" class="home-nav-link">Katalog</NavLink>
        <NavLink href="/vergleich" class="home-nav-link">Vergleich</NavLink>
        <NavLink href="/methodik" class="home-nav-link">Methodik</NavLink>
    </nav>

    <section class="material-section" aria-labelledby="materialbereiche-title">
        <p class="eyebrow">Materialdatenbank</p>
        <h1 id="home-title" class="home-title">Klimawirksame Materialien vergleichen</h1>
        <p class="home-intro">
            Eine strukturierte Übersicht für Fassaden, Böden und Dächer. Materialien können nach
            ökologischen und stadtklimatischen Kriterien eingeordnet und miteinander verglichen werden.
        </p>

        <h2 id="materialbereiche-title" class="section-title">Materialbereiche</h2>

        <div class="material-area-grid">
            @foreach (var area in MaterialAreas)
            {
                <article class="material-area-card">
                    <div>
                        <h3>@area.Title</h3>
                        <p>@area.Description</p>
                    </div>
                    <NavLink href="/katalog" class="card-link">Öffnen →</NavLink>
                </article>
            }
        </div>
    </section>

    <section class="science-section" aria-labelledby="science-title">
        <div class="science-content">
            <p class="eyebrow">Grundlage</p>
            <h2 id="science-title">Wissenschaftliche Grundlage</h2>
            <p>
                Die Bewertung basiert auf nachvollziehbaren Kriterien wie Kühlwirkung, Albedo,
                Treibhausgas-Emissionen, Versickerung und Lebensdauer. Die Methodik fasst Quellen,
                Annahmen und Bewertungsskalen transparent zusammen.
            </p>
            <NavLink href="/methodik" class="secondary-link">Methodik ansehen →</NavLink>
        </div>
    </section>

    <footer class="home-footer">
        <section aria-labelledby="contact-title">
            <h2 id="contact-title">Kontakt</h2>
            <p>Projektteam Materialdatenbank</p>
            <p>kontakt@meine-materialdatenbank.de</p>
            <p>Rückfragen zu Datengrundlagen und Materialeinträgen</p>
        </section>

        <section aria-labelledby="imprint-title">
            <h2 id="imprint-title">Impressum</h2>
            <p>Meine Materialdatenbank</p>
            <p>Angaben gemäss Projektvorgaben</p>
            <p>Stand: Prototyp</p>
        </section>
    </footer>
</div>

@code {
    private readonly List<MaterialArea> MaterialAreas = new()
    {
        new("Fassaden / Wände", "Materialien und Begrünungsvarianten für vertikale Gebäudeoberflächen."),
        new("Böden / Umgebung", "Beläge und Oberflächen für Aussenräume, Plätze, Wege und Aufenthaltsbereiche."),
        new("Dächer", "Dachaufbauten, Begrünung und Oberflächen mit Relevanz für Klima und Regenwasser.")
    };

    private record MaterialArea(string Title, string Description);
}
