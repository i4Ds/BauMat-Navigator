@page "/vergleich"
@implements IDisposable
@inject CompareState CompareState
@inject MaterialService MaterialService

<PageTitle>Materialvergleich</PageTitle>

@if (ComparedMaterials.Count == 0)
{
    <section class="comparison-empty">
        <h1>Materialvergleich</h1>
        <p>Du hast noch keine Materialien für den Vergleich ausgewählt.</p>
        <a href="katalog">Zum Katalog →</a>
    </section>
}
else
{
    <section class="comparison-page">
        <ComparisonHeader Count="@ComparedMaterials.Count" OnClear="CompareState.Clear" />

        <ViewToggle Active="ComparisonView.Table" />

        <div class="comparison-content">
            <div class="comparison-table-wrapper">
                <table class="comparison-table">
                    <thead>
                        <tr>
                            <th scope="col" class="comparison-param-head">Parameter</th>

                            @foreach (var material in ComparedMaterials)
                            {
                                <th scope="col" class="comparison-col-head">
                                    <div class="comparison-col-top">
                                        <span class="comparison-col-name">@material.Name</span>
                                        <button class="comparison-col-remove"
                                                title="Aus Vergleich entfernen"
                                                aria-label="@($"{material.Name} aus Vergleich entfernen")"
                                                @onclick="() => RemoveFromCompare(material.Id)"
                                                @onclick:stopPropagation="true">
                                            ×
                                        </button>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var (label, value) in Parameters)
                        {
                            <tr>
                                <th scope="row">@label</th>

                                @foreach (var material in ComparedMaterials)
                                {
                                    <td class="comparison-value">@value(material)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="comparison-add-panel">
                @if (!CompareState.IsFull)
                {
                    <a class="comparison-add-btn" href="@AddMaterialHref">
                        + Material hinzufügen
                    </a>
                }
                else
                {
                    <span class="comparison-add-limit" title="Maximal @CompareState.MaxCount Materialien im Vergleich">
                        Maximum erreicht
                    </span>
                }
            </div>
        </div>
    </section>
}

@code {
    // Side-by-side material comparison (Issue #9). Materials are resolved
    // from MaterialService.All (not CompareState.Ids directly) so the
    // column order stays stable and matches the catalog order.
    private IReadOnlyList<Material> ComparedMaterials =>
        MaterialService.All
            .Where(material => CompareState.Contains(material.Id))
            .ToList();

    private static readonly (string Label, Func<Material, string> Value)[] Parameters =
    {
        ("Konstruktionstyp", m => m.ConstructionType),
        ("PET Tag", m => $"{m.PetTag:0.0} °C"),
        ("Albedo", m => m.Albedo.ToString("0.00")),
        ("Lebensdauer", m => $"{m.Lifespan} Jahre"),
        ("THG", m => $"{m.Ghg:0.#} kg CO₂-eq/m²"),
    };

    private const string AddMaterialHref = "katalog?returnTo=table";

    protected override void OnInitialized()
    {
        CompareState.OnChanged += HandleCompareStateChanged;
    }

    private void HandleCompareStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void RemoveFromCompare(int id) => CompareState.Toggle(id);

    public void Dispose()
    {
        CompareState.OnChanged -= HandleCompareStateChanged;
    }
}
